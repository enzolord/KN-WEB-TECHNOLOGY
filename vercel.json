{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?path=/sitemap.xml"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/seo?path=/blog/:slug"
    },
    {
      "source": "/solutions/:slug",
      "destination": "/api/seo?path=/solutions/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
