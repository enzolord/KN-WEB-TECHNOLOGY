# Copiez ce fichier en ".env" et remplissez avec vos identifiants Supabase
# (Dashboard Supabase -> Project Settings -> API)

# "Project URL" exacte : identifiant du projet (20 caractères), PAS le nom du site.
# Ex. correct : https://abcdefghijklmnopqrst.supabase.co — incorrect : https://knwebtechnology.supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Numéro WhatsApp affiché par défaut (peut aussi être géré depuis /admin/settings)
VITE_WHATSAPP_NUMBER=237640288619

# Variables à définir chez l'hébergeur (pas dans .env) pour le SEO sans redéploiement :
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=votre-cle-anon-publique
